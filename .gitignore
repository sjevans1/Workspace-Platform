# Repo hygiene (#223): a tracked ABSOLUTE symlink at this path reached main and
# broke fresh clones, because `node_modules/` matches a directory only. This
# pattern matches the directory and any file/symlink of the same name.
node_modules
.next
.env
.env.*
!.env.example
.data/
backups/
playwright-report/
test-results/
e2e/.auth/
e2e-connected-work/.auth/
test-results/connected-work/
*.log
*.tsbuildinfo

/apps/web/next-env.d.ts

# W27: generated release artifacts and local scratch. The binary is produced by
# build/w27/build-caddy-patched.sh and consumed from a temporary build context; only its
# SHA-256 is recorded in docs/security and provenance.
.w27-evidence/
# W27 aggregate gate: phase 1 evidence is regenerated by CI (and locally by
# scripts/ci/w27-collect-evidence.sh) and published as the w27-security-evidence artifact.
w27-evidence/
build/w27/images/*/*.bin
build/w27/caddy/
build/w27/seaweedfs/

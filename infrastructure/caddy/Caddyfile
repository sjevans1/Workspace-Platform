{$CADDY_ADDRESS::80} {
  {$CADDY_TLS_DIRECTIVE:}
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-Frame-Options SAMEORIGIN
    Cross-Origin-Opener-Policy same-origin
    Cross-Origin-Resource-Policy same-origin
    X-Permitted-Cross-Domain-Policies none
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  handle /collaboration* {
    reverse_proxy collab:1234
  }
  handle /api/* {
    reverse_proxy api:4000 {
      # Discard every upstream client XFF/X-Real-IP claim. Fastify trusts only
      # this single Caddy hop, and Caddy emits the actual socket peer.
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle /scim/* {
    reverse_proxy api:4000 {
      # Discard every upstream client XFF/X-Real-IP claim. Fastify trusts only
      # this single Caddy hop, and Caddy emits the actual socket peer.
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle /health {
    reverse_proxy api:4000 {
      # Discard every upstream client XFF/X-Real-IP claim. Fastify trusts only
      # this single Caddy hop, and Caddy emits the actual socket peer.
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle /ready {
    reverse_proxy api:4000 {
      # Discard every upstream client XFF/X-Real-IP claim. Fastify trusts only
      # this single Caddy hop, and Caddy emits the actual socket peer.
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle /metrics {
    reverse_proxy api:4000 {
      # Discard every upstream client XFF/X-Real-IP claim. Fastify trusts only
      # this single Caddy hop, and Caddy emits the actual socket peer.
      header_up X-Forwarded-For {remote_host}
      header_up X-Real-IP {remote_host}
    }
  }
  handle {
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    reverse_proxy web:3000
  }
}

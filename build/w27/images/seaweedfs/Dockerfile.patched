# W27: patched-upstream SeaweedFS acceptance image.
#
# This is NOT a mirror and NOT a shipped customer component: it is an acceptance-only artifact
# that preserves the approved upstream 4.48 runtime and replaces only /usr/bin/weed with the
# Workspace-rebuilt binary. The Alpine runtime, /entrypoint.sh, filer configuration, the Rust
# weed-volume and worker binaries, libraries, ports and entrypoint/CMD behaviour are inherited
# unchanged.
#
# Base note: the CI-H1 mirror records upstream tag 4.47, while this rebuild targets the approved
# upstream 4.48 release, so the runtime base is the upstream 4.48 image rather than the mirror.
ARG SW_RUNTIME=docker.io/chrislusf/seaweedfs:4.48
FROM ${SW_RUNTIME}

LABEL org.opencontainers.image.title="Workspace patched acceptance SeaweedFS" \
      org.opencontainers.image.description="Upstream SeaweedFS 4.48 (commit 530be3e37337488ecc34d58441e0bc476e121c93) with only the Go weed binary rebuilt by Workspace using Go 1.26.9 and golang.org/x/net v0.60.0. Acceptance-only, not a mirror, not an upstream image." \
      org.opencontainers.image.source="https://github.com/sjevans1/Workspace-Platform" \
      org.openjm.workspace.image.classification="patched-upstream" \
      org.openjm.workspace.image.intendedUse="acceptance-only" \
      org.openjm.workspace.upstream.tag="4.48" \
      org.openjm.workspace.upstream.commit="530be3e37337488ecc34d58441e0bc476e121c93" \
      org.openjm.workspace.weed.binary.sha256="ff8d09e4a8c921f35a7a65b988c541d74f0b01725197ddb7fdf5728f2be37cb2" \
      org.openjm.workspace.builder="golang@sha256:d9c68c2c51161e12fd77e4c6320687c9cd86e1af1e3ad6e6cd63ff970641453c"

# Replace only the Go binary and verify the installed bytes match the frozen identity, so the
# image cannot silently carry a different binary than the one that was scanned.
COPY --chown=root:root weed-patched.bin /usr/bin/weed
RUN set -euo pipefail \
 && chmod 0755 /usr/bin/weed \
 && got="$(sha256sum /usr/bin/weed | cut -d' ' -f1)" \
 && [ "$got" = "ff8d09e4a8c921f35a7a65b988c541d74f0b01725197ddb7fdf5728f2be37cb2" ] \
 && /usr/bin/weed version \
 && echo "patched weed installed with verified hash $got"

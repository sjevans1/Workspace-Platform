# Generate with: node scripts/init-env.mjs
POSTGRES_PASSWORD=GENERATE_OWNER_PASSWORD
RUNTIME_DB_PASSWORD=GENERATE_RUNTIME_PASSWORD
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY
SETUP_TOKEN=GENERATE_SETUP_TOKEN
APP_URL=http://localhost:8080
CADDY_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional deployment-level OpenID Connect / Keycloak sign-in.
# Use the issuer identifier, e.g. https://id.example.com/realms/acme
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Single sign-on
OIDC_SCOPES=openid profile email
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Development/testing only. Production issuers should use HTTPS.
OIDC_ALLOW_INSECURE=false
# Set false only after OIDC has been tested for the owner/admin break-glass path.
LOCAL_AUTH_ENABLED=true
PRODUCT_NAME=OpenJM Workspace
PRIMARY_ACCENT="#177a64"
LOGO_LIGHT=
LOGO_DARK=
FAVICON=
LOGIN_BACKGROUND=
SUPPORT_NAME=Workspace support
SUPPORT_URL=
LEGAL_NAME=
PRIVACY_URL=
TERMS_URL=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/data/files
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=workspace
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Comma-separated exact origins. Empty disables webhook registration/delivery.
WEBHOOK_ALLOWED_ORIGINS=

# Internal worker health thresholds; not published by Caddy.
WORKER_HEALTH_MAX_TICK_MS=60000
WORKER_HEALTH_GRACE_MS=10000

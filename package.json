{
  "name": "openjm-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "dev:web": "npm run dev -w apps/web",
    "start:api": "node --import tsx apps/api/src/main.ts",
    "start:collab": "node --import tsx apps/collab/src/main.ts",
    "start:worker": "node --import tsx apps/worker/src/main.ts",
    "migrate": "node --import tsx packages/database/migrate.ts",
    "typecheck": "tsc --noEmit && npm run typecheck -w apps/web",
    "build": "npm run build -w apps/web",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=90000 tests/*.test.ts",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write apps packages scripts tests e2e *.json *.ts *.yaml",
    "accept:s3": "node --import tsx scripts/accept-production-s3.ts",
    "verify:s3-provider": "node --import tsx scripts/validate-s3-provider.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/server-util": "0.55.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.6",
    "yjs": "13.6.33",
    "zod": "4.6.5",
    "openid-client": "6.8.8",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "^3.6.2",
    "typescript": "7.0.2"
  }
}
